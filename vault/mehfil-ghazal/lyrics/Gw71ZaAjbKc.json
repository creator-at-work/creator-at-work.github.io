      "lines": [
        "Abhi to main jawan hoon"
      ],
      "en": "I am still young."
    },
    {
      "start": 26.61,
      "end": 29.7,
      "lines": [
        "Hawa bhi khushgawar hai"
      ],
      "en": "The breeze is gentle."
    },
    {
      "start": 29.7,
      "end": 32.18,
      "lines": [
        "Gulon pe bhi nikhar hai"
      ],
      "en": "The flowers glow with new life."
    },
    {
      "start": 34.05,
      "end": 36.89,
      "lines": [
        "Tarannum hazar hain"
      ],
      "en": "A thousand melodies fill the air."
    },
    {
      "start": 36.89,
      "end": 39.75,
      "lines": [
        "Bahar purbahar hai"
      ],
      "en": "Spring is in full bloom."
    },
    {
      "start": 39.85,
      "end": 41.96,
      "lines": [
        "Kahan chala hai saqiya"
      ],
      "en": "Where are you going, cupbearer?"
    },
    {
      "start": 42.91,
      "end": 49.12,
      "lines": [
        "Idhar to laut, idhar to aa"
      ],
      "en": "Turn back and come this way."
    },
    {
      "start": 49.12,
      "end": 52.75,
      "lines": [
        "Are, yeh dekhta hai kya"
      ],
      "en": "What are you looking at?"
    },
    {
      "start": 52.75,
      "end": 55.79,
      "lines": [
        "Utha subu, subu utha"
      ],
      "en": "Lift the wine flask."
    },
    {
      "start": 56.82,
      "end": 59.47,
      "lines": [
        "Subu utha, pyala bhar"
      ],
      "en": "Lift the flask and fill the cup."
    },
    {
      "start": 59.47,
      "end": 62.04,
      "lines": [
        "Pyala bhar ke de idhar"
      ],
      "en": "Fill the cup and pass it here."
    },
    {
      "start": 62.04,
      "end": 65.81,
      "lines": [
        "Chaman ki samt kar nazar"
      ],
      "en": "Turn your eyes toward the garden."
    },
    {
      "start": 65.91,
      "end": 69.08,
      "lines": [
        "Saman to dekh, bekhabar"
      ],
      "en": "Look around and see what you have missed."
    },
    {
      "start": 69.96,
      "end": 76.82,
      "lines": [
        "Woh kali kali badliyan"
      ],
      "en": "See those dark clouds gathering."
    },
    {
      "start": 76.92,
      "end": 80.24,
      "lines": [
        "Ufuq pe ho gayin ayan"
      ],
      "en": "They have come into view on the horizon."
    },
    {
      "start": 84.54,
      "end": 86.86,
      "lines": [
        "Woh ek hujum-e-maikashan"
      ],
      "en": "Look how the drinkers have gathered."
    },
    {
      "start": 88.26,
      "end": 90.37,
      "lines": [
        "Yeh kya guman hai, badguman"
      ],
      "en": "What makes you so suspicious?"
    },
    {
      "start": 90.37,
      "end": 93.41,
      "lines": [
        "Samajh na mujh ko natawan"
      ],
      "en": "Do not take me for someone frail."
    },
    {
      "start": 93.9,
      "end": 96.34,
      "lines": [
        "Khayal-e-zohd abhi kahan"
      ],
      "en": "What thought have I yet for abstinence?"
    },
    {
      "start": 96.34,
      "end": 104.73,
      "lines": [
        "Abhi to main jawan hoon"
      ],
      "en": "I am still young."
    },
    {
      "start": 104.73,
      "end": 106.6,
      "lines": [
        "Ibadaton ka zikr hai"
      ],
      "en": "There is talk of prayer."
    },
    {
      "start": 107.87,
      "end": 109.1,
      "lines": [
        "Najat ki bhi fikr hai"
      ],
      "en": "There is worry, too, about salvation."
    },
    {
      "start": 128.76,
      "end": 130.75,
      "lines": [
        "Junun hai sawab ka"
      ],
      "en": "There is a fervour for earning grace."
    },
    {
      "start": 132.01,
      "end": 133.94,
      "lines": [
        "Khayal hai azab ka"
      ],
      "en": "The thought of punishment weighs on you."
    },
    {
      "start": 133.95,
      "end": 137.03,
      "lines": [
        "Magar suno to, shaikh ji"
      ],
      "en": "Hear me a moment, preacher."
    },
    {
      "start": 137.52,
      "end": 138.56,
      "lines": [
        "Ajib shai hain aap bhi"
      ],
      "en": "You are a curious one yourself."
    },
    {
      "start": 141.95,
      "end": 144.69,
      "lines": [
        "Bhala shabab-o-ashiqi"
      ],
      "en": "What of youth and falling in love?"
    },
    {
      "start": 144.69,
      "end": 146.26,
      "lines": [
        "Alag hue bhi hain kabhi"
      ],
      "en": "Have they ever parted company?"
    },
    {
      "start": 156.7,
      "end": 159.77,
      "lines": [
        "Hasin jalwarez hon"
      ],
      "en": "Beauty shines wherever you look."
    },
    {
      "start": 163.92,
      "end": 165.15,
      "lines": [
        "Adaen fitna-khez hon"
      ],
      "en": "Every glance can stir up trouble."
    },
    {
      "start": 167.84,
      "end": 169.5,
      "lines": [
        "Hawaen itr-bez hon"
      ],
      "en": "The breeze carries perfume."
    },
    {
      "start": 172.58,
      "end": 173.64,
      "lines": [
        "To shauq kyun na tez hon"
      ],
      "en": "How could desire stay quiet?"
    },
    {
      "start": 180.78,
      "end": 182.72,
      "lines": [
        "Koi idhar, koi udhar"
      ],
      "en": "There is one here and another there."
    },
    {
      "start": 182.72,
      "end": 184.62,
      "lines": [
        "Ubharte hon aish par"
      ],
      "en": "They beckon you toward pleasure."
    },
    {
      "start": 184.62,
      "end": 187.49,
      "lines": [
        "Tumhara nuqta-e-nazar"
      ],
      "en": "I can see how it looks to you."
    },
    {
      "start": 187.59,
      "end": 192.73,
      "lines": [
        "Durust hai to ho magar"
      ],
      "en": "You may well be right."
    },
    {
      "start": 193.64,
      "end": 195.64,
      "lines": [
        "Abhi to main jawan hoon"
      ],
