  "couplets": [
    {
      "start": 22.0,
      "end": 31.5,
      "lines": [
        "Jab yaad tumhari aayegi"
      ],
      "en": "When thoughts of you return."
    },
    {
      "start": 31.5,
      "end": 39.0,
      "lines": [
        "Yaadon ka samandar nam hoga"
      ],
      "en": "The sea of memory will fill with tears."
    },
    {
      "start": 42.0,
      "end": 47.3,
      "lines": [
        "Jab yaad tumhari aayegi"
      ],
      "en": "When thoughts of you return."
    },
    {
      "start": 47.3,
      "end": 53.0,
      "lines": [
        "Yaadon ka samandar nam hoga"
      ],
      "en": "The sea of memory will fill with tears."
    },
    {
      "start": 53.0,
      "end": 64.0,
      "lines": [
        "Be-khwaab nigaahein jaageingi"
      ],
      "en": "Sleepless eyes will stay open."
    },
    {
      "start": 64.0,
      "end": 69.5,
      "lines": [
        "Deewanon sa aalam hoga"
      ],
      "en": "Longing will carry me out of my senses."
    },
    {
      "start": 69.5,
      "end": 74.6,
      "lines": [
        "Jab yaad tumhari aayegi"
      ],
      "en": "When thoughts of you return."
    },
    {
      "start": 74.6,
      "end": 81.0,
      "lines": [
        "Yaadon ka samandar nam hoga"
      ],
      "en": "The sea of memory will fill with tears."
    },
    {
      "start": 103.0,
      "end": 110.5,
      "lines": [
        "Ab chaand sitaare aa kar ye"
      ],
      "en": "Now the moon and stars come near."
    },
    {
      "start": 110.5,
      "end": 118.0,
      "lines": [
        "Mujh se poochha karte hain"
      ],
      "en": "They keep asking me the same thing."
    },
    {
      "start": 118.0,
      "end": 124.0,
      "lines": [
        "Ab mere dil ke darwaaze"
      ],
      "en": "And the doors of my heart."
    },
    {
      "start": 124.0,
      "end": 130.0,
      "lines": [
        "Kyun khaali khaali rehte hain"
      ],
      "en": "Why do they stand so empty?"
    },
    {
      "start": 130.0,
      "end": 135.25,
      "lines": [
        "Main inko kya batlaaun, bata"
      ],
      "en": "Tell me what I can say to them."
    },
    {
      "start": 135.25,
      "end": 140.5,
      "lines": [
        "Main inko kya samjhaaun, bata"
      ],
      "en": "Tell me how I can make them understand."
    },
    {
      "start": 140.5,
      "end": 145.75,
      "lines": [
        "Kya laut ke tu kabhi aayega"
      ],
      "en": "Will you ever come back?"
    },
    {
      "start": 145.75,
      "end": 151.0,
      "lines": [
        "Kya phir se mujhe mil jaayega"
      ],
      "en": "Will I see you again?"
    },
    {
      "start": 151.0,
      "end": 156.0,
      "lines": [
        "Ya phir se khushi ka ghar hoga"
      ],
      "en": "Will happiness have a home here again?"
    },
    {
      "start": 156.0,
      "end": 161.0,
      "lines": [
        "Ya gham ye kabhi ab kam hoga"
      ],
      "en": "Will this grief ever ease?"
    },
    {
      "start": 161.0,
      "end": 167.0,
      "lines": [
        "Jab yaad tumhari aayegi"
      ],
      "en": "When thoughts of you return."
    },
    {
      "start": 167.0,
      "end": 174.0,
      "lines": [
        "Yaadon ka samandar nam hoga"
      ],
      "en": "The sea of memory will fill with tears."
    },
    {
      "start": 181.0,
      "end": 192.0,
      "lines": [
        "Tanhaai mein pal pal chup chaap"
      ],
      "en": "Alone in the quiet, moment after moment."
    },
    {
      "start": 192.0,
      "end": 204.9,
      "lines": [
        "Tere saath khinchi meri tasveerein"
      ],
      "en": "There are the photographs of us together."
    },
    {
      "start": 205.0,
      "end": 212.2,
      "lines": [
        "Mere seene se lag jaayengi"
      ],
      "en": "They will lie close against my chest."
    },
    {
      "start": 212.2,
      "end": 220.7,
      "lines": [
        "Tere saath khinchi meri tasveerein"
      ],
      "en": "There are the photographs of us together."
    },
    {
      "start": 220.74,
      "end": 225.9,
      "lines": [
        "Kuchh vasl mein doobi hui raatein"
      ],
      "en": "There were nights wholly lost in being together."
    },
    {
      "start": 225.9,
      "end": 231.0,
      "lines": [
        "Kuchh pyaare din yaad aayenge"
      ],
      "en": "A few dear days will come back to me."
    },
    {
      "start": 231.04,
      "end": 236.4,
      "lines": [
        "Teri saari qasmein, sab waade"
      ],
      "en": "I will remember every vow and every promise you made."
    },
    {
      "start": 236.4,
      "end": 241.6,
      "lines": [
        "Reh reh ke mujhe tadpaayenge"
      ],
      "en": "They will hurt again and again."
    },
    {
      "start": 241.64,
      "end": 246.84,
      "lines": [
        "Meri bheegi palkon ke peechhe"
      ],
      "en": "Behind my tear-wet lashes."
    },
    {
      "start": 246.88,
      "end": 251.92,
      "lines": [
        "Barsaaton ka mausam hoga"
      ],
      "en": "A whole season of rain will gather."
    },
    {
      "start": 251.96,
      "end": 257.52,
      "lines": [
        "Jab yaad tumhari aayegi"
      ],
      "en": "When thoughts of you return."
    },
    {
      "start": 257.56,
      "end": 264.56,
      "lines": [
        "Yaadon ka samandar nam hoga"
      ],
      "en": "The sea of memory will fill with tears."
    },
    {
      "start": 287.56,
      "end": 294.0,
      "lines": [
        "Jab tumko tanha paayengi"
      ],
      "en": "When they find you alone."
    },
    {
      "start": 294.0,
      "end": 301.25,
      "lines": [
        "Ye kaliyaan chup ho jaayengi"
      ],
      "en": "These buds will fall silent."
    },
    {
      "start": 301.56,
      "end": 307.06,
      "lines": [
        "Jab hum tum saath nahin honge"
      ],
      "en": "When you and I are apart."
    },
    {
      "start": 307.06,
      "end": 313.3,
      "lines": [
        "Phir kis ko ye mehkaayengi"
      ],
      "en": "Who will breathe in their fragrance then?"
    },
    {
      "start": 313.56,
      "end": 319.52,
      "lines": [
        "Us baagh, chaman aur bulbul ka ab"
      ],
      "en": "Even the garden and its nightingale will feel it."
    },
    {
      "start": 319.56,
      "end": 324.02,
      "lines": [
        "Gham hoga hum sa bilkul"
      ],
      "en": "Their grief will be just like ours."
    },
    {
      "start": 324.06,
      "end": 329.52,
      "lines": [
        "Tujhe soch ke royega woh gul"
      ],
      "en": "The rose will weep at the thought of you."
    },
    {
      "start": 329.56,
      "end": 335.02,
      "lines": [
        "Mujhe soch ke royegi bulbul"
      ],
      "en": "The nightingale will weep at the thought of me."
    },
    {
      "start": 335.06,
      "end": 340.02,
      "lines": [
        "Us baagh ke kone kone mein"
      ],
      "en": "In every corner of that garden."
    },
    {
      "start": 340.06,
      "end": 345.36,
      "lines": [
        "Hum donon ka maatam hoga"
      ],
      "en": "There will be mourning for us both."
    },
    {
      "start": 345.36,
      "end": 350.56,
      "lines": [
        "Jab yaad tumhari aayegi"
