      "en": "We had so many words left unsaid."
    },
    {
      "start": 54.76,
      "end": 58.4,
      "lines": [
        "Tasveerein banaate thay"
      ],
      "en": "We made pictures out of them."
    },
    {
      "start": 58.92,
      "end": 65.36,
      "lines": [
        "Parindon ke paron par nazm likh kar"
      ],
      "en": "We wrote poems on birds' wings."
    },
    {
      "start": 65.56,
      "end": 71.8,
      "lines": [
        "Door ki jheelon mein basne waale"
      ],
      "en": "Our listeners lived among distant lakes."
    },
    {
      "start": 72.64,
      "end": 77.12,
      "lines": [
        "Logon ko sunaate thay"
      ],
      "en": "We would read our poems to them."
    },
    {
      "start": 77.12,
      "end": 81.32,
      "lines": [
        "Jo humse door thay"
      ],
      "en": "They were far from us."
    },
    {
      "start": 81.72,
      "end": 88.36,
      "lines": [
        "Lekin hamaare paas rehte thay"
      ],
      "en": "Yet they stayed close."
    },
    {
      "start": 95.68,
      "end": 100.56,
      "lines": [
        "Naye din ki masaafat"
      ],
      "en": "A new day's journey lay ahead."
    },
    {
      "start": 100.56,
      "end": 104.24,
      "lines": [
        "Jab kiran ke saath"
      ],
      "en": "It came with a ray of light."
    },
    {
      "start": 104.36,
      "end": 109.28,
      "lines": [
        "Aangan mein utarti thi"
      ],
      "en": "It would settle in the courtyard."
    },
    {
      "start": 109.28,
      "end": 112.68,
      "lines": [
        "To hum kehte thay"
      ],
      "en": "Then we would speak."
    },
    {
      "start": 122.76,
      "end": 128.08,
      "lines": [
        "Hamein maathe pe bosa do"
      ],
      "en": "Kiss us on the forehead."
    },
    {
      "start": 128.08,
      "end": 133.04,
      "lines": [
        "Ke humko jugnuon ke"
      ],
      "en": "We must go where the fireflies live."
    },
    {
      "start": 133.48,
      "end": 139.0,
      "lines": [
